{
  "name": "plugins-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check:deps": "knip --dependencies",
    "dev": "pnpm turbo dev --filter=test-studio",
    "devtools:test-studio": "pnpm devtools:test-studio:build && ENABLE_VITE_DEVTOOLS=true pnpm dev",
    "devtools:test-studio:build": "pnpm build && ENABLE_VITE_DEVTOOLS=true pnpm --filter=test-studio build",
    "format": "oxfmt . --no-error-on-unmatched-pattern",
    "generate": "turbo gen",
    "issue-triage": "node scripts/trigger-triage/src/index.ts",
    "issue-triage:archive": "node scripts/trigger-triage/src/archive.ts",
    "knip": "knip",
    "lint": "pnpm run oxlint",
    "lint:fix": "pnpm lint --fix --fix-suggestions",
    "lint:workflows": "if command -v zizmor >/dev/null 2>&1; then zizmor .github --min-severity high; else echo 'zizmor not found. Install it: https://docs.zizmor.sh/installation/'; exit 1; fi",
    "oxlint": "oxlint --disable-nested-config",
    "postgenerate": "pnpm install && pnpm format && pnpm build",
    "postinstall": "husky",
    "pregenerate": "turbo run build --filter='./turbo/generators'",
    "pretest": "turbo run build --filter='!./dev/*'",
    "release": "changeset publish",
    "test": "vitest",
    "turbo:fix": "pnpm dlx rimraf ./node_modules && pnpm install && pnpm turbo scan",
    "typegen": "pnpm --filter=test-studio run typegen && pnpm format"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "setup-npm-trusted-publish": "^1.3.1",
    "turbo": "2.9.18",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-package-exports": "^1.2.0"
  },
  "devDependencies": {
    "knip": "^6.17.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.34.4"
}
