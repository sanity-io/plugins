{
  "name": "@sanity/route-pattern-compat",
  "version": "0.0.0",
  "private": true,
  "description": "Spike: can URLPattern match every route pattern path-to-regexp v6 accepted, so Presentation can stop being bound to path-to-regexp v8 semantics?",
