  "description": "Store localized fields in an array to save on attributes",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/plugins/tree/main/plugins/sanity-plugin-internationalized-array#readme",
  "bugs": {
