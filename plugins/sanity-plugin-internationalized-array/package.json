    "suspend-react": "0.1.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/package.config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/lodash": "^4.17.17"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^5",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=18"
