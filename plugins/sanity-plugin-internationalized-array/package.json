  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/plugins.git",
    "directory": "plugins/sanity-plugin-internationalized-array"
  },
  "files": [
    "dist",
    "src",
    "sanity.json"
  ],
  "type": "module",
