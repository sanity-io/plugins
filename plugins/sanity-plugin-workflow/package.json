{
  "name": "sanity-plugin-workflow",
  "version": "3.0.23",
  "description": "A demonstration of a custom content publishing workflow using Sanity.",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/plugins/tree/main/plugins/sanity-plugin-workflow#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/plugins/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/plugins.git",
    "directory": "plugins/sanity-plugin-workflow"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bundle.css": {
      "browser": "./dist/bundle.css",
      "style": "./dist/bundle.css",
      "node": "./dist/bundle.css.js",
      "default": "./dist/bundle.css.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./bundle.css": {
        "browser": "./dist/bundle.css",
        "style": "./dist/bundle.css",
        "node": "./dist/bundle.css.js",
        "default": "./dist/bundle.css.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg build --strict --check --clean",
    "prepack": "turbo run build"
  },
  "dependencies": {
    "@hello-pangea/dnd": "catalog:",
    "@sanity/icons": "catalog:",
    "@sanity/ui": "catalog:",
    "@tanstack/react-virtual": "^3.14.4",
    "lexorank": "catalog:",
    "motion": "catalog:",
    "sanity-plugin-utils": "workspace:^"
  },
  "devDependencies": {
    "@repo/package.config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sanity/pkg-utils": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "react": "catalog:",
    "sanity": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^5 || ^6.0.0-0"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
