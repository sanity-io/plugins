    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peer",
    "react-dom": "catalog:peer",
    "sanity": "catalog:peer",
    "styled-components": "catalog:peer"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
