{
  "name": "@sanity/themer",
  "version": "0.9.0",
  "description": "Generate Sanity Studio themes, and preview them with a Studio tool.",
  "keywords": [
    "sanity",
    "studio",
    "theme",
    "themer",
    "ui"
  ],
  "homepage": "https://github.com/sanity-io/plugins/tree/main/plugins/%40sanity/themer#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/plugins/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/plugins.git",
    "directory": "plugins/@sanity/themer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/tool.js",
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "imports": {
    "#constants": "./src/tool/constants.ts",
    "#context": "./src/tool/context.ts",
    "#reducer": "./src/tool/reducer.ts",
    "#types": "./src/tool/types.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy/index.ts",
    "./tool": "./src/tool/index.ts",
    "./bundle.css": {
      "types": "./dist/bundle-css.d.ts",
      "browser": "./dist/bundle.css",
      "style": "./dist/bundle.css",
      "node": "./dist/bundle-css.js",
      "default": "./dist/bundle-css.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./legacy": "./dist/legacy.js",
      "./tool": "./dist/tool.js",
      "./bundle.css": {
        "types": "./dist/bundle-css.d.ts",
        "browser": "./dist/bundle.css",
        "style": "./dist/bundle.css",
        "node": "./dist/bundle-css.js",
        "default": "./dist/bundle-css.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "turbo run build"
  },
  "dependencies": {
    "@sanity/color": "catalog:",
    "@sanity/icons": "catalog:",
    "@sanity/themer-legacy": "^0.2.1",
    "@sanity/ui": "catalog:",
    "@vanilla-extract/dynamic": "catalog:",
    "@xstate/react": "catalog:",
    "dequal": "catalog:",
    "motion": "catalog:",
    "react-refractor": "^4.0.0",
    "refractor": "^5.0.0",
    "scroll-into-view-if-needed": "catalog:",
    "valibot": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@sanity/tsconfig": "catalog:",
    "@sanity/tsdown-config": "catalog:",
    "@sanity/vanilla-extract-vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "lightningcss": "^1.33.0",
    "oxc-transform-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "styled-components": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^3 || ^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "sanity": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
