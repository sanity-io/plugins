    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "react-is": "^18.3 || ^19",
    "sanity": "^3.78 || ^4.0.0-0 || ^5 || ^6.0.0-0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "eslintImports": false,
      "scripts": false
    }
  }
