    "@tanem/react-nprogress": "^5.0.63",
    "copy-to-clipboard": "^3.3.3",
    "date-fns": "^4.0.0",
    "filesize": "^9.0.11",
    "groq": "^6.1.0",
    "is-hotkey-esm": "^1.0.0",
    "nanoid": "^3.3.12",
    "pluralize": "^8.0.0",
    "react-dropzone": "^11.3.1",
