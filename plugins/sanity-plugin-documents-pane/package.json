{
  "name": "sanity-plugin-documents-pane",
  "version": "4.1.5",
  "description": "Displays the results of a GROQ query in a View Pane",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/plugins/tree/main/plugins/sanity-plugin-documents-pane#readme",
