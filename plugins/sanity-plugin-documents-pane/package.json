    "@sanity/ui": "catalog:",
    "@sanity/util": "catalog:",
    "@sanity/uuid": "^3.0.3",
    "dlv": "^1.1.3",
    "rxjs": "catalog:",
    "sanity-plugin-utils": "workspace:^"
  },
  "devDependencies": {
    "@repo/package.config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sanity/pkg-utils": "catalog:",
    "@types/dlv": "^1.1.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "babel-plugin-styled-components": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "styled-components": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
