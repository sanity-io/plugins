{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "quoteProps": "consistent",
  "experimentalSortImports": {},
  "sortPackageJson": {"sortScripts": true},
  "ignorePatterns": [
    "dist/**",
    "pnpm-lock.yaml",
    ".changeset/*.md",
    "turbo/**/*.hbs",
    "plugins/sanity-plugin-mux-input/**"
  ]
}
