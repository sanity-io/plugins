# Required for e2e (copy to `.env.local` — gitignored)
#
# Prefer SANITY_E2E_SESSION_TOKEN. STUDIO_AUTH_TOKEN is accepted as a fallback
# (Cursor cloud agents already inject it).

SANITY_E2E_SESSION_TOKEN=
# STUDIO_AUTH_TOKEN=

SANITY_E2E_PROJECT_ID=ppsg7ml5
SANITY_E2E_STUDIO_DATASET=plugins
SANITY_E2E_BASE_URL=http://localhost:3333

# Optional
# HEADLESS=true
# SANITY_E2E_DEBUG=true
