{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "dev/*",
    // Moved as-is from the standalone repo; will be brought up to monorepo
    // standards (and into knip coverage) in a follow-up PR
    "plugins/sanity-plugin-media",
    // Moved verbatim from sanity-io/sanity-plugin-mux-input; legacy dead-code
    // and phantom-dependency cleanup is deferred to a follow-up PR.
    "plugins/sanity-plugin-mux-input",
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "ignoreIssues": {
    // IntrinsicDefinitions in `declare module 'sanity'` is a declaration merging pattern, not unused
    "plugins/**/src/schema.{ts,tsx}": ["types", "nsTypes"],
    "plugins/**/src/schema/**/*.{ts,tsx}": ["types", "nsTypes"],
    "plugins/**/src/schemas/**/*.{ts,tsx}": ["types", "nsTypes"],
  },
  "rules": {
    // dev/* workspaces are ignored, so their catalog entries appear unused
    "catalog": "warn",
  },
  "workspaces": {
    ".": {
      "entry": ["*.{ts,mts,mjs}"],
      "project": ["*.{ts,mts,mjs}"],
      "ignoreDependencies": [
        // TypeScript native compiler, used as a dev tool not imported
        "@typescript/native-preview",
      ],
      "ignoreBinaries": [
        // Provided by sanity package in dev/test-studio, which is an ignored workspace
        "sanity",
        // Installed externally (not an npm package); used in lint:workflows script
        "zizmor",
      ],
    },
    "turbo/generators": {
      "project": ["src/**/*.ts"],
    },
    "packages/@repo/tsconfig": {},
    "packages/@repo/package.config": {
      "project": ["src/**/*.ts"],
    },
    "packages/@sanity/plugin-kit": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        // Spawned as a CLI (`yalc push`) by the link-watch command, never imported
        "yalc",
        // Provides ambient typings consumed by nodemon APIs, not runtime imported
        "@types/nodemon",
        // Resolved at runtime by ESLint/tsc when verifying generated plugin fixtures in tests
        "eslint-config-prettier",
        "eslint-config-sanity",
        "eslint-plugin-prettier",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "prettier",
        "react",
        "react-dom",
        "sanity",
        "styled-components",
        "@types/react",
      ],
    },
    "plugins/@sanity/assist": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        // Used by @sanity/pkg-utils babel transform, not directly imported
        "babel-plugin-styled-components",
      ],
    },
    "plugins/@sanity/code-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        // Used by @sanity/pkg-utils babel transform, not directly imported
        "babel-plugin-styled-components",
      ],
    },
    "plugins/@sanity/color-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        // Used by @sanity/pkg-utils babel transform, not directly imported
        "babel-plugin-styled-components",
