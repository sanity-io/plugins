    },
    "plugins/sanity-plugin-utils": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-google-translate": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-latex-input": {
