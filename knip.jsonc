    },

    "plugins/@sanity/debug-live-sync-tags": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },

    "plugins/@sanity/presets": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-naive-html-serializer": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
  },
}
