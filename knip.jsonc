{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "ignoreIssues": {
    // IntrinsicDefinitions in `declare module 'sanity'` is a declaration merging pattern, not unused
    "plugins/**/src/schema.{ts,tsx}": ["types", "nsTypes"],
    "plugins/**/src/schema/**/*.{ts,tsx}": ["types", "nsTypes"],
    "plugins/**/src/schemas/**/*.{ts,tsx}": ["types", "nsTypes"],
  },
  "ignoreDependencies": [
    "@vanilla-extract/css",
    "babel-plugin-react-compiler",
    "babel-plugin-styled-components",
  ],
  "workspaces": {
    ".": {
      "entry": ["*.{ts,mts,mjs}"],
      "project": ["*.{ts,mts,mjs}"],
      "ignoreDependencies": [
        // TypeScript native compiler, used as a dev tool not imported
        "@typescript/native-preview",
      ],
      "ignoreBinaries": [
        // Installed externally (not an npm package); used in lint:workflows script
        "zizmor",
      ],
    },
    "dev/test-studio": {
      "entry": ["migrations/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "turbo/generators": {
      "project": ["src/**/*.ts"],
    },
    "packages/@repo/package.config": {
      "project": ["src/**/*.ts"],
    },
    "packages/@sanity/plugin-kit": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        // Spawned as a CLI (`yalc push`) by the link-watch command, never imported
        "yalc",
        // Resolved at runtime by ESLint/tsc when verifying generated plugin fixtures in tests
        "eslint-config-prettier",
        "eslint-config-sanity",
        "eslint-plugin-prettier",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "prettier",
        "react",
        "react-dom",
        "sanity",
        "styled-components",
        "@types/react",
      ],
    },
    "plugins/@sanity/assist": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/code-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/color-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/debug-preview-url-secret-plugin": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/document-internationalization": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/rich-date-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/studio-secrets": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/vercel-protection-bypass": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/@sanity/language-filter": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-aprimo": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-asset-source-unsplash": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-bynder-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-graph-view": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-iframe-pane": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-internationalized-array": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-translations-tab": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-markdown": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-media": {
      "entry": ["package.config.ts", "scripts/migrate-to-localized-fields.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-mux-input": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "plugins/sanity-plugin-workflow": {
