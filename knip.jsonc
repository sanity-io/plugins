    },

    "plugins/@sanity/dashboard": {
      "entry": ["package.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },

    "plugins/sanity-plugin-documents-pane": {
      "entry": ["package.config.ts"],
