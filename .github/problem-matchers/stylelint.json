{
  "problemMatcher": [
    {
      "owner": "stylelint",
      "pattern": [
        {
          "regexp": "^(\\S.*\\.css)$",
          "file": 1
        },
        {
          "regexp": "^\\s+(\\d+):(\\d+)\\s+\\S+\\s+(.+?)\\s{2,}(\\S+)$",
          "line": 1,
          "column": 2,
          "message": 3,
          "code": 4,
          "loop": true
        }
      ]
    }
  ]
}
