{
  "name": "{{ name }}",
  "version": "{{ version }}",
  "description": "{{ description }}",
{{#if keywords}}
  "keywords": {{{ json keywords }}},
{{else}}
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
{{/if}}
  "homepage": "https://github.com/sanity-io/plugins/tree/main/plugins/{{ name }}#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/plugins.git",
    "directory": "plugins/{{ name }}"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
{{#if hasVanillaExtract}}
    "./bundle.css": {
      "browser": "./dist/bundle.css",
      "style": "./dist/bundle.css",
      "node": "./dist/bundle.css.js",
      "default": "./dist/bundle.css.js"
    },
{{/if}}
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "turbo run build"
  },
{{#if dependencies}}
  "dependencies": {{{ json dependencies }}},
{{else}}
  "dependencies": {
    "@sanity/ui": "catalog:"
  },
{{/if}}
  "devDependencies": {
    "@sanity/tsconfig": "catalog:",
    "@sanity/tsdown-config": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
{{#if hasVanillaExtract}}
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
{{/if}}
    "babel-plugin-react-compiler": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
{{#if hasStyledComponents}}
    "styled-components": "catalog:",
{{/if}}
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^5 || ^6.0.0-0"{{#if hasStyledComponents}},
    "styled-components": "^6.1"{{/if}}
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
{{#if hasVanillaExtract}}
      "./bundle.css": {
        "browser": "./dist/bundle.css",
        "style": "./dist/bundle.css",
        "node": "./dist/bundle.css.js",
        "default": "./dist/bundle.css.js"
      },
{{/if}}
      "./package.json": "./package.json"
    }
  }
}
